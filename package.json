{
  "name": "thaigov-directory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build.mjs",
    "build:full": "SITE_MODE=full node scripts/build.mjs",
    "build:coming-soon": "SITE_MODE=coming-soon node scripts/build.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "audit:robots": "node scripts/audit-robots.mjs",
    "deploy": "npm run build && wrangler versions upload",
    "deploy:live": "npm run build && wrangler deploy",
    "sync:crawl": "node scripts/sync-crawl.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "satori": "^0.33.4",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.127.0"
  },
  "engines": {
    "node": ">=20"
  }
}
